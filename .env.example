# ==============================================================================
# FresherFlow - Multi-Agent Resume Parser & CV Customizer Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys and configuration details.

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER API KEYS & MODEL CONFIGURATIONS
# ------------------------------------------------------------------------------

# Google Gemini Configuration
# Primary parser agent engine (Free tier has rate limits)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative Gemini Models: gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro, gemini-pro

# Groq Configuration (Fast Inference, Free Tier options)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative Groq Models: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

# Anthropic Claude Configuration
# High-quality reasoning engine
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Alternative Claude Models: claude-3-5-haiku-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229

# OpenAI ChatGPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Alternative OpenAI Models: gpt-4o, gpt-4-turbo, gpt-4-turbo-preview, o1-mini, o1-preview

# Ollama Configuration (Local / Self-hosted LLMs)
# No API key required. Make sure Ollama service is running.
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternative Ollama Models: qwen2.5-coder:1.5b, llama3.1, mistral, phi3, llama2
OLLAMA_BASE_URL=http://localhost:11434
# Note: For ngrok or remote Ollama URLs, provide the full URL (e.g., https://<id>.ngrok-free.dev)

# Kimi (Moonshot AI) Configuration (LangChain OpenAI-compatible wrapper)
KIMI_API_KEY=your_kimi_api_key_here

# ------------------------------------------------------------------------------
# 2. AGENT ORCHESTRATION & FALLBACK CONFIGURATION
# ------------------------------------------------------------------------------

# Fallback Order for `llm_provider.py` fallback chain
# comma-separated provider list (fallback tries them in this sequence)
# Supported: ollama, gemini, groq, claude, openai
LLM_PROVIDER_ORDER=ollama,gemini,groq,claude,openai

# Specific LLM Provider assignment for individual agents:
# Agent 1: Parser Agent (extracts and structures CV information)
PARSER_LLM_PROVIDER=gemini

# Agent 2: Job Search Agent (matches profiles against job postings)
JOB_SEARCH_LLM_PROVIDER=claude

# Agent 3: CV Tailor Agent (customizes CV experience & generates LaTeX)
CV_TAILOR_LLM_PROVIDER=chatgpt

# ------------------------------------------------------------------------------
# 3. EXTERNAL APIS & INTEGRATIONS
# ------------------------------------------------------------------------------

# Overleaf Integration (for publishing compiled LaTeX CVs)
# Note: Either OVERLEAF_API_KEY or OVERLEAF_EMAIL/PASSWORD credentials
OVERLEAF_API_KEY=your_overleaf_api_key_here
OVERLEAF_EMAIL=your-email@example.com
OVERLEAF_PASSWORD=your_overleaf_password_here

# ATS Scoring Integration (ResumeWorded or similar API)
ATS_SCORING_API_KEY=your_ats_scoring_key_here
ATS_TARGET_SCORE=95

# Job Search APIs
LINKEDIN_API_KEY=your_linkedin_api_key_here
INDEED_API_KEY=your_indeed_api_key_here
REMOTIVE_API_KEY=optional
THEMUSE_API_KEY=optional
RESUMEWORDED_API_KEY=optional

# ------------------------------------------------------------------------------
# 4. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
FLASK_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8080
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
LOG_LEVEL=INFO

