# CV Customizer Environment Configuration
# Copy this to .env and fill in your API keys

# LLM Provider Configuration
PARSER_LLM_PROVIDER=gemini
JOB_SEARCH_LLM_PROVIDER=claude
CV_TAILOR_LLM_PROVIDER=chatgpt

# API Keys - Get these from respective platforms
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Overleaf Configuration
OVERLEAF_EMAIL=
OVERLEAF_PASSWORD=

# ATS Scoring API
ATS_SCORING_API_KEY=
ATS_TARGET_SCORE=95

# Job Search APIs
LINKEDIN_API_KEY=
INDEED_API_KEY=

# Application Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# File Upload Configuration
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# Selenium Configuration
SELENIUM_HEADLESS=True
SELENIUM_BROWSER=chrome

# Database Configuration (optional, for future use)
DATABASE_URL=
REDIS_URL=
