# FresherFlow - Multi-Agent Resume Parser
# Copy this file to .env and fill in your API keys

# LLM Provider - Groq (fallback)
GROQ_API_KEY=optional
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Provider - Claude (fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM Provider - OpenAI / ChatGPT (fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LLM Provider - Google Gemini (fallback)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LLM Provider - Ollama / Qwen (default)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override fallback order (default: ollama,gemini,groq,claude,openai)
# LLM_PROVIDER_ORDER=ollama,gemini,groq,claude,openai

# Job APIs
REMOTIVE_API_KEY=optional
THEMUSE_API_KEY=optional

# Overleaf Integration (for CV generation)
OVERLEAF_API_KEY=optional
OVERLEAF_EMAIL=your-email@example.com

# ResumeWorded ATS Checker (if using API instead of scraping)
RESUMEWORDED_API_KEY=optional

# App Configuration
FLASK_ENV=development
DEBUG=true
PORT=8080
