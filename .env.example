# Google Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# Provider Priority & Agent Mapping
LLM_PROVIDER_ORDER=ollama,gemini,groq
PARSER_LLM_PROVIDER=gemini
JOB_SEARCH_LLM_PROVIDER=groq
CV_TAILOR_LLM_PROVIDER=ollama

# Overleaf Credentials
OVERLEAF_EMAIL=your-email@example.com
OVERLEAF_PASSWORD=your_overleaf_password_here

# ATS Scoring (e.g., ResumeWorded)
ATS_SCORING_API_KEY=your_ats_scoring_key_here
ATS_TARGET_SCORE=95

# Job Search APIs
LINKEDIN_API_KEY=your_linkedin_api_key_here
INDEED_API_KEY=your_indeed_api_key_here

# Application Server
DEBUG=true
HOST=0.0.0.0
PORT=8080
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true
